{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Storage": {
    "Provider": "Cloudinary",
    "FallbackProvider": "Local",
    "MaxImageSizeMB": 5,
    "MaxVideoSizeMB": 100,
    "AllowedImageTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "AllowedVideoTypes": [ "video/mp4", "video/webm", "video/quicktime" ],
    "LocalBasePath": "wwwroot/uploads",
    "PublicBaseUrl": "https://localhost:5001/uploads"
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "Folder": "fitplatform"
  },
  "AbacatePay": {
    "BaseUrl": "https://api.abacatepay.com/v2",
    "ApiKey": "",
    "WebhookSecret": "",
    "WebhookPublicKey": "",
    "SuccessUrl": "http://localhost:5173/onboarding/success",
    "ReturnUrl": "http://localhost:5173/onboarding/return",
    "DevMode": true
  },
  "RateLimiting": {
    "Policies": {
      "AuthLogin": { "PermitLimit": 30, "WindowSeconds": 60, "QueueLimit": 0 },
      "StudentRegister": { "PermitLimit": 20, "WindowSeconds": 60, "QueueLimit": 0 },
      "TrainerOnboarding": { "PermitLimit": 40, "WindowSeconds": 60, "QueueLimit": 0 },
      "PublicLead": { "PermitLimit": 20, "WindowSeconds": 60, "QueueLimit": 0 },
      "ExplorePublicSearch": { "PermitLimit": 180, "WindowSeconds": 60, "QueueLimit": 0 }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=FitPlatformDb;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}
