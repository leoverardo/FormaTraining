{
  "//": "Modelo versionado. Copie para appsettings.json (ignorado pelo git) e ajuste. NUNCA coloque secrets reais aqui.",

  "Platform": {
    "//": "Domínios públicos da plataforma. Definir por ambiente: Platform__FrontendBaseUrl / Platform__ApiBaseUrl.",
    "FrontendBaseUrl": "http://localhost:5173",
    "ApiBaseUrl": "http://localhost:5000",
    "OnboardingSuccessPath": "/onboarding/success",
    "OnboardingReturnPath": "/onboarding/return"
  },

  "AllowedOrigins": "http://localhost:5173",
  "FrontendUrl": "http://localhost:5173",

  "Jwt": {
    "Secret": "SET_JWT_SECRET_VIA_ENV",
    "Issuer": "FitPlatform",
    "Audience": "FitPlatformUsers"
  },

  "AbacatePay": {
    "BaseUrl": "https://api.abacatepay.com/v2",
    "ApiKey": "SET_ABACATEPAY_API_KEY_VIA_ENV",
    "WebhookSecret": "SET_ABACATEPAY_WEBHOOK_SECRET_VIA_ENV",
    "WebhookPublicKey": "SET_ABACATEPAY_WEBHOOK_PUBLIC_KEY_VIA_ENV",

    "//SuccessUrl": "Deixe vazio para derivar de Platform:FrontendBaseUrl + OnboardingSuccessPath.",
    "SuccessUrl": "",
    "ReturnUrl": "",
    "//TrainerPanelUrl": "Retorno de checkouts feitos pelo painel do trainer. Vazio = Platform:FrontendBaseUrl + /trainer/subscription.",
    "TrainerPanelUrl": "",

    "//DevMode": "true somente quando a ApiKey for do ambiente de testes. Em produção deve ser false: eventos devMode são registrados e ignorados.",
    "DevMode": false,

    "//EnableSignatureValidation": "Obrigatoriamente true fora de Development — a aplicação não sobe com false em produção.",
    "EnableSignatureValidation": true,

    "PaymentMethod": "CARD",
    "EnableCouponSync": true,

    "RetryPolicy": {
      "MaxRetry": 3,
      "RetryEvery": 1
    },

    "Reconciliation": {
      "Enabled": true,
      "IntervalMinutes": 15,
      "MinPendingAgeMinutes": 20,
      "MaxPendingAgeDays": 7,
      "BatchSize": 25,
      "MaxAttemptsPerSubscription": 8,
      "MaxListPages": 5,

      "//VerifyActiveSubscriptions": "Confere assinaturas ativas contra o provedor — rede de segurança para webhooks de cancelamento/expiração perdidos.",
      "VerifyActiveSubscriptions": true,
      "ActiveBatchSize": 25,
      "ActiveRecheckHours": 12,

      "WebhookRetryBatchSize": 25,
      "WebhookMaxRetries": 5,
      "WebhookRetryBackoffMinutes": 5
    }
  },

  "Storage": {
    "Provider": "Cloudinary",
    "FallbackProvider": "Local",
    "MaxImageSizeMB": 5,
    "MaxVideoSizeMB": 100,
    "AllowedImageTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "AllowedVideoTypes": [ "video/mp4", "video/webm", "video/quicktime" ],
    "LocalBasePath": "wwwroot/uploads",
    "//PublicBaseUrl": "Use o mesmo host de Platform:ApiBaseUrl.",
    "PublicBaseUrl": "http://localhost:5000/uploads"
  },

  "Cloudinary": {
    "CloudName": "SET_CLOUDINARY_CLOUD_NAME_VIA_ENV",
    "ApiKey": "SET_CLOUDINARY_API_KEY_VIA_ENV",
    "ApiSecret": "SET_CLOUDINARY_API_SECRET_VIA_ENV",
    "Folder": "fitplatform"
  },

  "RateLimiting": {
    "Policies": {
      "AuthLogin": { "PermitLimit": 15, "WindowSeconds": 60, "QueueLimit": 0 },
      "StudentRegister": { "PermitLimit": 10, "WindowSeconds": 60, "QueueLimit": 0 },
      "TrainerOnboarding": { "PermitLimit": 20, "WindowSeconds": 60, "QueueLimit": 0 },
      "PublicLead": { "PermitLimit": 12, "WindowSeconds": 60, "QueueLimit": 0 },
      "ExplorePublicSearch": { "PermitLimit": 90, "WindowSeconds": 60, "QueueLimit": 0 }
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "SET_CONNECTION_STRING_VIA_ENV"
  }
}
