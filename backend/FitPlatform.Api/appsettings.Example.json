{
  "AllowedOrigins": "https://app.formatraining.com",
  "FrontendUrl": "https://app.formatraining.com",
  "Jwt": {
    "Secret": "SET_STRONG_SECRET_VIA_ENV",
    "Issuer": "FitPlatform",
    "Audience": "FitPlatformUsers"
  },
  "AbacatePay": {
    "BaseUrl": "https://api.abacatepay.com/v2",
    "ApiKey": "SET_ABACATEPAY_API_KEY_VIA_ENV",
    "WebhookSecret": "SET_ABACATEPAY_WEBHOOK_SECRET_VIA_ENV",
    "WebhookPublicKey": "SET_ABACATEPAY_WEBHOOK_PUBLIC_KEY_VIA_ENV",
    "SuccessUrl": "https://app.formatraining.com/onboarding/success",
    "ReturnUrl": "https://app.formatraining.com/onboarding/return",
    "DevMode": false
  },
  "Storage": {
    "Provider": "Cloudinary",
    "FallbackProvider": "Local",
    "MaxImageSizeMB": 5,
    "MaxVideoSizeMB": 100,
    "AllowedImageTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "AllowedVideoTypes": [ "video/mp4", "video/webm", "video/quicktime" ],
    "LocalBasePath": "wwwroot/uploads",
    "PublicBaseUrl": "https://api.formatraining.com/uploads"
  },
  "Cloudinary": {
    "CloudName": "SET_CLOUDINARY_CLOUD_NAME_VIA_ENV",
    "ApiKey": "SET_CLOUDINARY_API_KEY_VIA_ENV",
    "ApiSecret": "SET_CLOUDINARY_API_SECRET_VIA_ENV",
    "Folder": "fitplatform"
  },
  "RateLimiting": {
    "Policies": {
      "AuthLogin": { "PermitLimit": 15, "WindowSeconds": 60, "QueueLimit": 0 },
      "StudentRegister": { "PermitLimit": 10, "WindowSeconds": 60, "QueueLimit": 0 },
      "TrainerOnboarding": { "PermitLimit": 20, "WindowSeconds": 60, "QueueLimit": 0 },
      "PublicLead": { "PermitLimit": 12, "WindowSeconds": 60, "QueueLimit": 0 },
      "ExplorePublicSearch": { "PermitLimit": 90, "WindowSeconds": 60, "QueueLimit": 0 }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=FitPlatformDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  }
}
